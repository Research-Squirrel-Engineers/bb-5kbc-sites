<http://archaeology.link/ontology#Location> a owl:Class ;
    rdfs:subClassOf <https://pleiades.stoa.org/places/vocab#Location> .

<http://archaeology.link/ontology#PlaceType> a owl:Class ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> .

<http://fuzzy-sl.squirrel.link/ontology/LocationType> a owl:Class ;
    rdfs:subClassOf <http://fuzzy-sl.squirrel.link/ontology/Type> .

<http://fuzzy-sl.squirrel.link/ontology/PointType> a owl:Class ;
    rdfs:subClassOf <http://fuzzy-sl.squirrel.link/ontology/Type> .

