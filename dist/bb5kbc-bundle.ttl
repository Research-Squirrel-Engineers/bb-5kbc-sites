@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://archaeology.link/ontology#Event> a owl:Class ;
    rdfs:label "LADO Event"@en ;
    rdfs:isDefinedBy <http://archaeology.link/ontology#> ;
    rdfs:subClassOf crm:E5_Event .

<http://archaeology.link/ontology#Place> a owl:Class ;
    rdfs:label "LADO Place"@en ;
    rdfs:isDefinedBy <http://archaeology.link/ontology#> ;
    rdfs:subClassOf <https://pleiades.stoa.org/places/vocab#Place> .

fsl:activityDesc a owl:DatatypeProperty ;
    rdfs:label "activity description"@en ;
    rdfs:isDefinedBy fsl: .

fsl:certaintyLevel a owl:ObjectProperty ;
    rdfs:label "certainty level"@en ;
    rdfs:isDefinedBy fsl: .

fsl:georeferencingBy a owl:ObjectProperty ;
    rdfs:label "georeferencing by"@en ;
    rdfs:isDefinedBy fsl: .

fsl:hasLocationType a owl:ObjectProperty ;
    rdfs:label "has location type"@en ;
    rdfs:isDefinedBy fsl: .

fsl:hasPointType a owl:ObjectProperty ;
    rdfs:label "has point type"@en ;
    rdfs:isDefinedBy fsl: .

fsl:hasReference a owl:ObjectProperty ;
    rdfs:label "has reference"@en ;
    rdfs:isDefinedBy fsl: .

fsl:hasSourceType a owl:ObjectProperty ;
    rdfs:label "has source type"@en ;
    rdfs:isDefinedBy fsl: .

fsl:hasSourceTypeDetail a owl:ObjectProperty ;
    rdfs:label "has source type detail"@en ;
    rdfs:isDefinedBy fsl: .

fsl:method a owl:ObjectProperty ;
    rdfs:label "method"@en ;
    rdfs:isDefinedBy fsl: .

fsl:methodUsed a owl:ObjectProperty ;
    rdfs:label "method used"@en ;
    rdfs:isDefinedBy fsl: .

fsl:representativeGeometry a owl:ObjectProperty ;
    rdfs:label "representative geometry"@en ;
    rdfs:isDefinedBy fsl: .

data:bb5kbc_bundle_ttl a prov:Entity ;
    rdfs:label "bb5kbc-bundle.ttl (data + ontology, self-contained)"@en ;
    prov:atLocation <file:///C:/git/bb-5kbc-sites/dist/bb5kbc-bundle.ttl> ;
    prov:wasDerivedFrom ns1:fst_wgs84_csv ;
    prov:wasGeneratedBy data:pipeline_run_2026-04-29T07-22-41Z .

data:bb5kbc_data_ttl a prov:Entity ;
    rdfs:label "bb5kbc-data.ttl (LOD-converted site data)"@en ;
    prov:atLocation <file:///C:/git/bb-5kbc-sites/dist/bb5kbc-data.ttl> ;
    prov:wasDerivedFrom ns1:fst_wgs84_csv ;
    prov:wasGeneratedBy data:pipeline_run_2026-04-29T07-22-41Z .

bb5kbc: a owl:Ontology ;
    dcterms:contributor "Florian Thiery",
        "Sophie C. Schmidt" ;
    dcterms:creator "Florian Thiery",
        "Sophie C. Schmidt" ;
    dcterms:issued "2026-04-25"^^xsd:date ;
    dcterms:modified "2026-04-28"^^xsd:date ;
    dcterms:rights "CC BY 4.0" ;
    dcterms:subject "archaeology; Neolithic; Brandenburg; Linked Open Data; NFDI4Objects"@en ;
    dcterms:title "Brandenburg 5000 BC Fundstellen-Ontologie"@de,
        "Brandenburg 5000 BC Sites Ontology"@en ;
    rdfs:comment """Application ontology for the Brandenburg 5000 BC sites dataset (Schmidt 2026).

## Data namespace

`http://w3id.org/bb5kbc/`

## URI patterns

**FID-based, per-site nodes:**

* `site_{FID}` → `bb5kbc:Fundstelle`
* `site_{FID}_activity` → `bb5kbc:GeoreferenzierungsAktivitaet`
* `site_{FID}_geom` → `sf:Point`
* `site_{FID}_culture` → `bb5kbc:KulturelleZuordnung` (per-site connector to shared Kulturgruppe)
* `site_{FID}_dating` → `bb5kbc:Datierung` (per-site, with site-specific start/end/certainty)

**Hash-based (`MD5(label_utf8)[:8]`), deduplicated:**

* `gemeinde_{hash}` → `bb5kbc:Gemeinde`
* `kreis_{hash}` → `bb5kbc:Kreis`
* `bundesland_{hash}` → `bb5kbc:Bundesland`
* `land_{hash}` → `bb5kbc:Land`
* `kultur_{hash}` → `bb5kbc:Kulturgruppe` (shared concept node)
* `entdeckung_{hash}` → `bb5kbc:Entdeckung`
* `entdeckungsart_{hash}` → `bb5kbc:EntdeckungsartType`
* `fundstellenart_{hash}` → `bb5kbc:FundstellenartType`
* `pub_{hash}` → `bb5kbc:Publikation`
* `methode_{hash}` → `fsl:MethodType`
* `quellentyp_{hash}` → `fsl:SourceType`
* `datmethode_{hash}` → `bb5kbc:DatierungsMethodeType`
* `sherd_{hash}` → `bb5kbc:Scherbe` (hash from Wikidata QID)

External identifiers (TGN + iDAI + OSM) on all 4 administrative levels.

## CM Literals (on `bb5kbc:GeoreferenzierungsAktivitaet`)

* `quelle_georef` (`fsl:hasReference` / `fsl:activityDesc`, **P25**) → `xsd:string`
* `QID_quelle_georef` (`fsl:hasReference`, **P31**) → Wikidata URI
* `methode` (`fsl:method` / `fsl:methodUsed`, **P7**) → `fsl:MethodType` Named Node
* `quellen_typ` (`fsl:hasSourceType` + `fsl:hasSourceTypeDetail`, **P6 + P16**) → `fsl:SourceType` Named Node
* `methodenbeschr` (`fsl:activityDesc`, **P15**) → `xsd:string`
* `genauigkeit_m` (`fsl:precision`, **P23**) → `xsd:decimal` (on `bb5kbc:Fundstelle`)
* `wgs84_x/y` (`geosparql:asWKT`) → on `sf:Point` (skip if both = 0,0)"""@en ;
    owl:versionIRI bb5kbc:0.9 ;
    owl:versionInfo "0.9" ;
    schema:image <https://research-squirrel-engineers.github.io/bb-5kbc-sites/ontology/bb-5kbc-ontology.jpg> .

bb5kbc:ExternalIdentifier_PerioDo a bb5kbc:externalIdentifierType,
        owl:NamedIndividual ;
    rdfs:label "Perio.do"@en ;
    skos:prefLabel "Perio.do"@en .

bb5kbc:datierungEnd a owl:DatatypeProperty ;
    rdfs:label "Datierung Ende"@de,
        "dating end"@en ;
    rdfs:comment "End of the dating range (dating_end). Integer year (negative = BCE). SubPropertyOf crm:P82b_end_of_the_end."@en ;
    rdfs:domain bb5kbc:Datierung ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf crm:P82b_end_of_the_end .

bb5kbc:datierungMethode a owl:ObjectProperty ;
    rdfs:label "Datierungsmethode"@de,
        "dating method"@en ;
    rdfs:domain bb5kbc:Datierung ;
    rdfs:range bb5kbc:DatierungsMethodeType ;
    rdfs:subPropertyOf crm:P2_has_type .

bb5kbc:datierungSicherheitEnd a owl:DatatypeProperty ;
    rdfs:label "Sicherheit Ende"@de,
        "certainty end"@en ;
    rdfs:comment "Certainty qualifier for dating_end (dating_certainty_end). SubPropertyOf fsl:certaintyDesc."@en ;
    rdfs:domain bb5kbc:Datierung ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf fsl:certaintyDesc .

bb5kbc:datierungSicherheitRange a owl:DatatypeProperty ;
    rdfs:label "Sicherheit Zeitraum"@de,
        "certainty range"@en ;
    rdfs:comment "Certainty qualifier for the overall range (dating_certainty_range, e.g. 'ca.'). SubPropertyOf fsl:certaintyDesc."@en ;
    rdfs:domain bb5kbc:Datierung ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf fsl:certaintyDesc .

bb5kbc:datierungSicherheitStart a owl:DatatypeProperty ;
    rdfs:label "Sicherheit Beginn"@de,
        "certainty start"@en ;
    rdfs:comment "Certainty qualifier for dating_start (dating_certainty_start). SubPropertyOf fsl:certaintyDesc."@en ;
    rdfs:domain bb5kbc:Datierung ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf fsl:certaintyDesc .

bb5kbc:datierungStart a owl:DatatypeProperty ;
    rdfs:label "Datierung Beginn"@de,
        "dating start"@en ;
    rdfs:comment "Start of the dating range (dating_start). Integer year (negative = BCE). SubPropertyOf crm:P82a_begin_of_the_begin; use time:hasBeginning / time:inXSDgYear for OWL Time."@en ;
    rdfs:domain bb5kbc:Datierung ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf crm:P82a_begin_of_the_begin .

bb5kbc:hasExternalIdentifier a owl:ObjectProperty ;
    rdfs:label "has external identifier"@en ;
    rdfs:comment "Links a bb5kbc entity to a URI in an external authority (TGN, iDAI, OSM, Wikidata, Perio.do, GeoNames). Replaces arno:hasExternalIdentifier for this ontology."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range rdfs:Resource ;
    rdfs:subPropertyOf skos:closeMatch .

bb5kbc:hasExternalIdentifierType a owl:ObjectProperty ;
    rdfs:label "has external identifier type"@en ;
    rdfs:comment "Links an external authority URI to its identifier type (e.g. bb5kbc:ExternalIdentifier_TGN)."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range bb5kbc:externalIdentifierType .

bb5kbc:hatDatierung a owl:ObjectProperty ;
    rdfs:label "hat Datierung"@de,
        "has dating"@en ;
    rdfs:comment "Links a bb5kbc:KulturelleZuordnung to its bb5kbc:Datierung node. SubPropertyOf crm:P4_has_time-span."@en ;
    rdfs:domain bb5kbc:KulturelleZuordnung ;
    rdfs:range bb5kbc:Datierung ;
    rdfs:subPropertyOf crm:P4_has_time-span .

bb5kbc:hatEntdeckungsart a owl:ObjectProperty ;
    rdfs:label "hat Entdeckungsart"@de,
        "has discovery type"@en ;
    rdfs:comment "Type of the discovery / encounter event (Ausgrabung, Lesefund, etc.). Subproperty of crm:P2_has_type."@en ;
    rdfs:domain bb5kbc:Entdeckung ;
    rdfs:range bb5kbc:EntdeckungsartType ;
    rdfs:subPropertyOf crm:P2_has_type .

bb5kbc:hatFID a owl:DatatypeProperty ;
    rdfs:label "FID"@de,
        "site PID"@en ;
    rdfs:comment """Primary identifier (PID) of the Fundstelle in the Schmidt 2026 catalogue (FID column).

SubPropertyOf both `crm:P1_is_identified_by` and `dcterms:identifier` — appears as `dcterms:identifier "1"^^xsd:integer` (explicit identifier statement).

URI basis:

* `http://w3id.org/bb5kbc/site_{FID}`
* `http://w3id.org/bb5kbc/site_{FID}_activity`
* `http://w3id.org/bb5kbc/site_{FID}_geom`"""@en ;
    rdfs:domain bb5kbc:Fundstelle ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf dcterms:identifier,
        crm:P1_is_identified_by .

bb5kbc:hatFundstellenID a owl:DatatypeProperty ;
    rdfs:label "Fundstellen-ID"@de,
        "site ID"@en ;
    rdfs:domain bb5kbc:Fundstelle ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf crm:P1_is_identified_by .

bb5kbc:hatFundstellenart a owl:ObjectProperty ;
    rdfs:label "hat Fundstellenart"@de,
        "has site type"@en ;
    rdfs:comment """Type of the archaeological site (Siedlung, Grab, KGA, etc.).
Doubly anchored: subPropertyOf crm:P2_has_type (CRM type assignment) and
fsl:siteType (FSL Wikibase site-type relation)."""@en ;
    rdfs:domain bb5kbc:Fundstelle ;
    rdfs:range bb5kbc:FundstellenartType ;
    rdfs:subPropertyOf fsl:siteType,
        crm:P2_has_type .

bb5kbc:hatGenauigkeit a owl:DatatypeProperty ;
    rdfs:label "Genauigkeit (m)"@de,
        "spatial accuracy (m)"@en ;
    rdfs:comment "Spatial accuracy in metres (genauigkeit_m). SubPropertyOf fsl:precision."@en ;
    rdfs:domain bb5kbc:Fundstelle ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf fsl:precision .

bb5kbc:hatKatalognummer a owl:DatatypeProperty ;
    rdfs:label "Katalognummer"@de,
        "catalogue number"@en ;
    rdfs:domain bb5kbc:Fundstelle ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf crm:P1_is_identified_by .

bb5kbc:hatKulturelleZuordnung a owl:ObjectProperty ;
    rdfs:label "hat kulturelle Zuordnung"@de,
        "has cultural assignment"@en ;
    rdfs:domain bb5kbc:Fundstelle ;
    rdfs:range bb5kbc:KulturelleZuordnung ;
    rdfs:subPropertyOf crm:P10i_contains .

bb5kbc:hatKulturgruppe a owl:ObjectProperty ;
    rdfs:label "hat Kulturgruppe"@de,
        "has cultural group"@en ;
    rdfs:domain bb5kbc:KulturelleZuordnung ;
    rdfs:range bb5kbc:Kulturgruppe ;
    rdfs:subPropertyOf crm:P9i_forms_part_of .

bb5kbc:hatPublikation a owl:ObjectProperty ;
    rdfs:label "hat Publikation"@de,
        "has publication"@en ;
    rdfs:domain bb5kbc:Fundstelle ;
    rdfs:range bb5kbc:Publikation ;
    rdfs:subPropertyOf crm:P70i_is_documented_in .

bb5kbc:hatScherbe a owl:ObjectProperty ;
    rdfs:label "hat Scherbe"@de,
        "has sherd"@en ;
    rdfs:comment "Links a bb5kbc:Fundstelle to one or more bb5kbc:Scherbe instances (sherd column). SubPropertyOf crm:P46i_forms_part_of."@en ;
    rdfs:domain bb5kbc:Fundstelle ;
    rdfs:range bb5kbc:Scherbe ;
    rdfs:subPropertyOf crm:P46i_forms_part_of .

bb5kbc:inBundesland a owl:ObjectProperty ;
    rdfs:label "liegt in Bundesland"@de,
        "located in federal state"@en ;
    rdfs:domain bb5kbc:Kreis ;
    rdfs:range bb5kbc:Bundesland ;
    rdfs:subPropertyOf fsl:locatedInAdministrativeEntity,
        crm:P89_falls_within .

bb5kbc:inGemeinde a owl:ObjectProperty ;
    rdfs:label "liegt in Gemeinde"@de,
        "located in municipality"@en ;
    rdfs:domain bb5kbc:Fundstelle ;
    rdfs:range bb5kbc:Gemeinde ;
    rdfs:subPropertyOf fsl:locatedInAdministrativeEntity,
        crm:P89_falls_within .

bb5kbc:inKreis a owl:ObjectProperty ;
    rdfs:label "liegt in Kreis"@de,
        "located in district"@en ;
    rdfs:domain bb5kbc:Gemeinde ;
    rdfs:range bb5kbc:Kreis ;
    rdfs:subPropertyOf fsl:locatedInAdministrativeEntity,
        crm:P89_falls_within .

bb5kbc:inLand a owl:ObjectProperty ;
    rdfs:label "liegt in Land"@de,
        "located in country"@en ;
    rdfs:domain bb5kbc:Bundesland ;
    rdfs:range bb5kbc:Land ;
    rdfs:subPropertyOf fsl:locatedInAdministrativeEntity,
        crm:P89_falls_within .

bb5kbc:wikidataMatchDescription a owl:DatatypeProperty ;
    rdfs:label "Wikidata-Match-Beschreibung"@de,
        "Wikidata match description"@en ;
    rdfs:comment """Audit note in plain text describing how this administrative entity was matched against Wikidata: method (exact / fuzzy / override / transitive P131+), normalisation steps applied, search label and matched label, and the confidence score. Carried over verbatim from the matchReason field produced by wikidata_map.py during CSV enrichment.

Multiple rdfs:domain triples are used (Land, Bundesland, Kreis, Gemeinde) rather than owl:unionOf, to keep auto-generated SHACL shapes simple — the auto-generator picks the first domain. The semantic restriction is: the property applies to any of the four administrative-area classes."""@en ;
    rdfs:domain bb5kbc:Bundesland,
        bb5kbc:Gemeinde,
        bb5kbc:Kreis,
        bb5kbc:Land ;
    rdfs:range xsd:string .

bb5kbc:wurdeEntdecktDurch a owl:ObjectProperty ;
    rdfs:label "wurde entdeckt durch"@de,
        "was discovered through"@en ;
    rdfs:domain bb5kbc:Fundstelle ;
    rdfs:range bb5kbc:Entdeckung ;
    rdfs:subPropertyOf crm:P12i_was_present_at .

bb5kbc:wurdeGeoreferenziertDurch a owl:ObjectProperty ;
    rdfs:label "wurde georeferenziert durch"@de,
        "was georeferenced through"@en ;
    rdfs:comment "Links a Fundstelle to the georeferencing activity that produced its coordinates. Subproperty of prov:wasGeneratedBy (PROV-O provenance)."@en ;
    rdfs:domain bb5kbc:Fundstelle ;
    rdfs:range bb5kbc:GeoreferenzierungsAktivitaet ;
    rdfs:subPropertyOf prov:wasGeneratedBy .

