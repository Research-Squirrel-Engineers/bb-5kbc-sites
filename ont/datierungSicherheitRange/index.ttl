@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/bb5kbc/ont/datierungSicherheitRange> a owl:DatatypeProperty,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "Sicherheit Zeitraum"@de,
        "certainty range"@en ;
    void:inDataset <http://w3id.org/bb5kbc/Brandenburg_5000_BC_Data> ;
    rdfs:comment "Certainty qualifier for the overall range (dating_certainty_range, e.g. 'ca.'). SubPropertyOf fsl:certaintyDesc."@en ;
    rdfs:domain <http://w3id.org/bb5kbc/ont/Datierung> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://fuzzy-sl.squirrel.link/ontology/certaintyDesc> .

