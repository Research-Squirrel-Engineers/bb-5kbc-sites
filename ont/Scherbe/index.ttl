@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .

<http://w3id.org/bb5kbc/ont/Scherbe> a owl:Class,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "Scherbe"@de,
        "Sherd"@en ;
    void:inDataset <http://w3id.org/bb5kbc/Brandenburg_5000_BC_Data> ;
    rdfs:comment """Ceramic sherd found at a Fundstelle (sherd column, 1-n Wikidata QIDs, delimiter |).
URI: sherd_{MD5(QID)[:8]}. Each QID gets its own Named Node typed bb5kbc:Scherbe,
linked to its Wikidata entity via bb5kbc:hasExternalIdentifier."""@en ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E22_Human-Made_Object> .

