@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .

<http://w3id.org/bb5kbc/ont/hasExternalIdentifierType> a owl:ObjectProperty,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "has external identifier type"@en ;
    void:inDataset <http://w3id.org/bb5kbc/Brandenburg_5000_BC_Data> ;
    rdfs:comment "Links an external authority URI to its identifier type (e.g. bb5kbc:ExternalIdentifier_TGN)."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range <http://w3id.org/bb5kbc/ont/externalIdentifierType> .

