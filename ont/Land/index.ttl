@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .

<http://w3id.org/bb5kbc/ont/Land> a owl:Class,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "Land"@de,
        "Country"@en ;
    void:inDataset <http://w3id.org/bb5kbc/Brandenburg_5000_BC_Data> ;
    rdfs:comment """Sovereign state (ISO 3166). URI: land_{MD5(label)[:8]}.
External identifiers: TGN, iDAI, OSM via bb5kbc:hasExternalIdentifier.
Only 2 values in dataset: Deutschland, Polen."""@en ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E53_Place> .

