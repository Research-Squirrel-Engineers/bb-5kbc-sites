@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .

<http://w3id.org/bb5kbc/ont/Entdeckung> a owl:Class,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "Entdeckung"@de,
        "Discovery / Encounter Event"@en ;
    void:inDataset <http://w3id.org/bb5kbc/Brandenburg_5000_BC_Data> ;
    rdfs:comment """Discovery/encounter event. URI: site_{FID}_discovery.
entdeckung column → rdfs:label literal (free text, 15 heterogeneous values
including proper names like 'Ausgrabung Bersu' — not a Named Node).
QID_entdeckung → bb5kbc:hatEntdeckungsart → bb5kbc:EntdeckungsartType (Named Node)."""@en ;
    rdfs:subClassOf <http://www.cidoc-crm.org/extensions/crmsci/S19_Encounter_Event> .

