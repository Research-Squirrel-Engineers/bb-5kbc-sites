@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/bb5kbc/ont/datierungEnd> a owl:DatatypeProperty,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "Datierung Ende"@de,
        "dating end"@en ;
    void:inDataset <http://w3id.org/bb5kbc/Brandenburg_5000_BC_Data> ;
    rdfs:comment "End of the dating range (dating_end). Integer year (negative = BCE). SubPropertyOf crm:P82b_end_of_the_end."@en ;
    rdfs:domain <http://w3id.org/bb5kbc/ont/Datierung> ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P82b_end_of_the_end> .

