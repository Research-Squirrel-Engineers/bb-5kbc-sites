@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/bb5kbc/ont/datierungStart> a owl:DatatypeProperty,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "Datierung Beginn"@de,
        "dating start"@en ;
    void:inDataset <http://w3id.org/bb5kbc/Brandenburg_5000_BC_Data> ;
    rdfs:comment "Start of the dating range (dating_start). Integer year (negative = BCE). SubPropertyOf crm:P82a_begin_of_the_begin; use time:hasBeginning / time:inXSDgYear for OWL Time."@en ;
    rdfs:domain <http://w3id.org/bb5kbc/ont/Datierung> ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P82a_begin_of_the_begin> .

