@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .

<http://w3id.org/bb5kbc/ont/EntdeckungsartType> a owl:Class,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "Entdeckungsart"@de,
        "Discovery Type"@en ;
    void:inDataset <http://w3id.org/bb5kbc/Brandenburg_5000_BC_Data> ;
    rdfs:comment """Type of discovery/encounter (Ausgrabung, Lesefund, Einzelfund).
crm:E55_Type as the type of a crmsci:S19_Encounter_Event — 'E55 Typus von
S19 Begegnung' per Sophie's README. WD QID via bb5kbc:hasExternalIdentifier."""@en ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> .

