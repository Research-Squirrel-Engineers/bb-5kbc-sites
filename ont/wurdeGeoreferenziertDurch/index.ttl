@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .

<http://w3id.org/bb5kbc/ont/wurdeGeoreferenziertDurch> a owl:ObjectProperty,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "wurde georeferenziert durch"@de,
        "was georeferenced through"@en ;
    void:inDataset <http://w3id.org/bb5kbc/Brandenburg_5000_BC_Data> ;
    rdfs:comment "Links a Fundstelle to the georeferencing activity that produced its coordinates. Subproperty of prov:wasGeneratedBy (PROV-O provenance)."@en ;
    rdfs:domain <http://w3id.org/bb5kbc/ont/Fundstelle> ;
    rdfs:range <http://w3id.org/bb5kbc/ont/GeoreferenzierungsAktivitaet> ;
    rdfs:subPropertyOf prov:wasGeneratedBy .

