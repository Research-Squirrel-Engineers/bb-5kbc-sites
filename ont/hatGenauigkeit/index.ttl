@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/bb5kbc/ont/hatGenauigkeit> a owl:DatatypeProperty,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "Genauigkeit (m)"@de,
        "spatial accuracy (m)"@en ;
    void:inDataset <http://w3id.org/bb5kbc/Brandenburg_5000_BC_Data> ;
    rdfs:comment "Spatial accuracy in metres (genauigkeit_m). SubPropertyOf fsl:precision."@en ;
    rdfs:domain <http://w3id.org/bb5kbc/ont/Fundstelle> ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf <http://fuzzy-sl.squirrel.link/ontology/precision> .

