@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .

<http://w3id.org/bb5kbc/ont/hatDatierung> a owl:ObjectProperty,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "hat Datierung"@de,
        "has dating"@en ;
    void:inDataset <http://w3id.org/bb5kbc/Brandenburg_5000_BC_Data> ;
    rdfs:comment "Links a bb5kbc:KulturelleZuordnung to its bb5kbc:Datierung node. SubPropertyOf crm:P4_has_time-span."@en ;
    rdfs:domain <http://w3id.org/bb5kbc/ont/KulturelleZuordnung> ;
    rdfs:range <http://w3id.org/bb5kbc/ont/Datierung> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span> .

