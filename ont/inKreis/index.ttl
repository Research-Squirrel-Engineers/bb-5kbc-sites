@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .

<http://w3id.org/bb5kbc/ont/inKreis> a owl:ObjectProperty,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "liegt in Kreis"@de,
        "located in district"@en ;
    void:inDataset <http://w3id.org/bb5kbc/Brandenburg_5000_BC_Data> ;
    rdfs:domain <http://w3id.org/bb5kbc/ont/Gemeinde> ;
    rdfs:range <http://w3id.org/bb5kbc/ont/Kreis> ;
    rdfs:subPropertyOf <http://fuzzy-sl.squirrel.link/ontology/locatedInAdministrativeEntity>,
        <http://www.cidoc-crm.org/cidoc-crm/P89_falls_within> .

