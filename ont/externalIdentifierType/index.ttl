@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .

<http://w3id.org/bb5kbc/ont/externalIdentifierType> a owl:Class,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "External Identifier Type"@en ;
    void:inDataset <http://w3id.org/bb5kbc/Brandenburg_5000_BC_Data> ;
    rdfs:comment "Type of external authority identifier (TGN, iDAI, OSM, Wikidata, Perio.do, GeoNames)."@en ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> .

