@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .

<http://w3id.org/bb5kbc/ont/hatEntdeckungsart> a owl:ObjectProperty,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "hat Entdeckungsart"@de,
        "has discovery type"@en ;
    void:inDataset <http://w3id.org/bb5kbc/Brandenburg_5000_BC_Data> ;
    rdfs:comment "Type of the discovery / encounter event (Ausgrabung, Lesefund, etc.). Subproperty of crm:P2_has_type."@en ;
    rdfs:domain <http://w3id.org/bb5kbc/ont/Entdeckung> ;
    rdfs:range <http://w3id.org/bb5kbc/ont/EntdeckungsartType> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> .

