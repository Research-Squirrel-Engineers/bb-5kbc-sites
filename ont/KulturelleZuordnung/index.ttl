@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .

<http://w3id.org/bb5kbc/ont/KulturelleZuordnung> a owl:Class,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "Kulturelle Zuordnung"@de,
        "Cultural Assignment"@en ;
    void:inDataset <http://w3id.org/bb5kbc/Brandenburg_5000_BC_Data> ;
    rdfs:comment "Spacetime assignment combining Fundstelle + Kulturgruppe + temporal period. URI: culture_{hash}. Has bb5kbc:hatDatierung → bb5kbc:Datierung (URI: culture_{hash}_dating)."@en ;
    rdfs:subClassOf <http://archaeology.link/ontology#SpaceTimeItem> .

