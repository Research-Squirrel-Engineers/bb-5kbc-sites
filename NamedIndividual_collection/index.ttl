@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix void: <http://rdfs.org/ns/void#> .

<http://w3id.org/bb5kbc/NamedIndividual_collection> a skos:Collection,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "NamedIndividual Instances Collection"@en ;
    void:inDataset <http://w3id.org/bb5kbc/Brandenburg_5000_BC_Data> ;
    rdfs:member <http://w3id.org/bb5kbc/ont/ExternalIdentifier_GeoNames>,
        <http://w3id.org/bb5kbc/ont/ExternalIdentifier_OSM>,
        <http://w3id.org/bb5kbc/ont/ExternalIdentifier_PerioDo>,
        <http://w3id.org/bb5kbc/ont/ExternalIdentifier_TGN>,
        <http://w3id.org/bb5kbc/ont/ExternalIdentifier_Wikidata>,
        <http://w3id.org/bb5kbc/ont/ExternalIdentifier_iDAI> .

