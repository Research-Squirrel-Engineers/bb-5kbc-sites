ns2:datierungEnd a owl:DatatypeProperty,
        <http://www.w3.org/ns/ldp#BasicContainer>,
        <http://www.w3.org/ns/ldp#Container>,
        <http://www.w3.org/ns/ldp#Resource> ;
    rdfs:label "Datierung Ende"@de,
        "dating end"@en ;
    void:inDataset ns4:Brandenburg_5000_BC_Data ;
    rdfs:comment "End of the dating range (dating_end). Integer year (negative = BCE). SubPropertyOf crm:P82b_end_of_the_end."@en ;
    rdfs:domain ns2:Datierung ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P82b_end_of_the_end> .

ns2:datierungMethode a owl:ObjectProperty,
        <http://www.w3.org/ns/ldp#BasicContainer>,
        <http://www.w3.org/ns/ldp#Container>,
        <http://www.w3.org/ns/ldp#Resource> ;
    rdfs:label "Datierungsmethode"@de,
        "dating method"@en ;
    void:inDataset ns4:Brandenburg_5000_BC_Data ;
    rdfs:domain ns2:Datierung ;
    rdfs:range ns2:DatierungsMethodeType ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> .

