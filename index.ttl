    rdfs:label "Sicherheit Ende"@de,
        "certainty end"@en ;
    void:inDataset ns4:Brandenburg_5000_BC_Data ;
    rdfs:comment "Certainty qualifier for dating_end (dating_certainty_end). SubPropertyOf fsl:certaintyDesc."@en ;
    rdfs:domain ns2:Datierung ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns1:certaintyDesc .

ns2:datierungSicherheitRange a owl:DatatypeProperty,
        <http://www.w3.org/ns/ldp#BasicContainer>,
