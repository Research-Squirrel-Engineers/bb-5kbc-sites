    rdfs:domain ns2:Datierung ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P82a_begin_of_the_begin> .

ns2:hasExternalIdentifierType a owl:ObjectProperty,
        <http://www.w3.org/ns/ldp#BasicContainer>,
        <http://www.w3.org/ns/ldp#Container>,
        <http://www.w3.org/ns/ldp#Resource> ;
    rdfs:label "has external identifier type"@en ;
    void:inDataset ns4:Brandenburg_5000_BC_Data ;
    rdfs:comment "Links an external authority URI to its identifier type (e.g. bb5kbc:ExternalIdentifier_TGN)."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range ns2:externalIdentifierType .

ns2:hatDatierung a owl:ObjectProperty,
        <http://www.w3.org/ns/ldp#BasicContainer>,
        <http://www.w3.org/ns/ldp#Container>,
        <http://www.w3.org/ns/ldp#Resource> ;
    rdfs:label "hat Datierung"@de,
        "has dating"@en ;
    void:inDataset ns4:Brandenburg_5000_BC_Data ;
    rdfs:comment "Links a bb5kbc:KulturelleZuordnung to its bb5kbc:Datierung node. SubPropertyOf crm:P4_has_time-span."@en ;
    rdfs:domain ns2:KulturelleZuordnung ;
    rdfs:range ns2:Datierung ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span> .

ns2:hatEntdeckungsart a owl:ObjectProperty,
        <http://www.w3.org/ns/ldp#BasicContainer>,
        <http://www.w3.org/ns/ldp#Container>,
        <http://www.w3.org/ns/ldp#Resource> ;
    rdfs:label "hat Entdeckungsart"@de,
        "has discovery type"@en ;
    void:inDataset ns4:Brandenburg_5000_BC_Data ;
    rdfs:comment "Type of the discovery / encounter event (Ausgrabung, Lesefund, etc.). Subproperty of crm:P2_has_type."@en ;
    rdfs:domain ns2:Entdeckung ;
    rdfs:range ns2:EntdeckungsartType ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> .

ns2:hatFID a owl:DatatypeProperty,
        <http://www.w3.org/ns/ldp#BasicContainer>,
        <http://www.w3.org/ns/ldp#Container>,
        <http://www.w3.org/ns/ldp#Resource> ;
    rdfs:label "FID"@de,
        "site PID"@en ;
    void:inDataset ns4:Brandenburg_5000_BC_Data ;
    rdfs:comment """Primary identifier (PID) of the Fundstelle in the Schmidt 2026 catalogue (FID column).
SubPropertyOf both crm:P1_is_identified_by and dc:identifier — appears as:
  dc:identifier "1"^^xsd:integer  (explicit identifier statement)
  URI basis: http://w3id.org/bb5kbc/site_{FID}
             http://w3id.org/bb5kbc/site_{FID}_activity
             http://w3id.org/bb5kbc/site_{FID}_geom"""@en ;
    rdfs:domain ns2:Fundstelle ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf dc:identifier,
        <http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by> .

